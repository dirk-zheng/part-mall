# 服务器监听 IP（默认 0.0.0.0 监听所有网卡）
HOST=0.0.0.0

# 服务器端口
PORT=3001

# development 或 production
NODE_ENV=development

# 生产环境必填：至少32字符的唯一强随机值
JWT_SECRET=

# 仅在首次执行 npm run seed 时使用；已有用户时seed会安全跳过
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# 网站聊天与询单邮件通知（QQ邮箱需使用SMTP授权码，不是登录密码）
ADMIN_NOTIFICATION_EMAIL=812353475@qq.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=812353475@qq.com
SMTP_PASS=rjckepwvyznwbfbb
